# ─── PWA (pwa/.env.local) ────────────────────────────────────────────────────
# The URL of your deployed Cloudflare Worker
VITE_WORKER_URL=https://findesk-worker.YOUR_SUBDOMAIN.workers.dev

# From your findesk Supabase project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...YOUR_ANON_KEY

# ─── Worker secrets (set via `wrangler secret put`, NOT stored in files) ──────
# FMP_API_KEY=your_fmp_api_key
# ALPACA_KEY_ID=your_alpaca_key_id
# ALPACA_SECRET_KEY=your_alpaca_secret_key

# ─── MCP server (set as env var when running) ─────────────────────────────────
# FMP_API_KEY=your_fmp_api_key
